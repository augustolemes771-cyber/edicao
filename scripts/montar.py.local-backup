#!/usr/bin/env python3
"""Monta o vídeo base de um projeto a partir de src/projetos/<projeto>/montagem.json.

Uso: python scripts/montar.py <projeto>
Gera public/projetos/<projeto>/<saida> (1080x1920, 30 fps, h264 + AAC) com um único filter_complex:
segmentos de vídeo/foto com cor (antes | escuro | depois), concat e mixagem da música com a voz dos segmentos "voz": true.
"""
import json
import subprocess
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent

# Gradações de cor (ffmpeg). "antes" frio e dessaturado com grão; "escuro" é o antes mais escuro e borrado; "depois" quente e vivo.
ANTES = "eq=saturation=0.35:contrast=1.05:brightness=-0.04,colorbalance=rs=-0.05:bs=0.06:rm=-0.03:bm=0.05,noise=alls=10:allf=t,vignette=PI/4.5"
COR = {
    "antes": ANTES,
    "escuro": "eq=saturation=0.35:contrast=1.05:brightness=-0.25,colorbalance=rs=-0.05:bs=0.06:rm=-0.03:bm=0.05,gblur=sigma=6,noise=alls=10:allf=t,vignette=PI/4.5",
    "depois": "eq=saturation=1.15:contrast=1.06,colorbalance=rs=0.04:bs=-0.04,vibrance=intensity=0.15",
}


def f(x):
    return f"{x:.5f}".rstrip("0").rstrip(".")


def montar_filtro(cfg, pasta):
    W, H, FPS = cfg.get("largura", 1080), cfg.get("altura", 1920), cfg.get("fps", 30)
    entradas, filtros, rotulos = [], [], []
    voz = []  # (indice da entrada, inicio no vídeo, dur, vel)
    t = 0.0
    for i, s in enumerate(cfg["segmentos"]):
        dur = float(s["dur"])
        cor = COR[s.get("cor", "depois")]
        idx = entradas.count("-i")
        if "foto" in s:
            z0, z1 = s.get("zoom", [1.0, 1.0])
            n = max(1, round(dur * FPS))
            entradas += ["-loop", "1", "-framerate", str(FPS), "-t", f(dur + 0.2), "-i", str(pasta / s["foto"])]
            # recorte central 9:16 do 3:4, escala 2x para o zoompan não serrilhar
            filtros.append(
                f"[{idx}:v]crop='min(iw,ih*{W}/{H})':'min(ih,iw*{H}/{W})',scale={W*2}:{H*2}:flags=lanczos,setsar=1,"
                f"zoompan=z='{f(z0)}+({f(z1)}-{f(z0)})*on/{n}':x='iw/2-iw/zoom/2':y='ih/2-ih/zoom/2':d=1:s={W}x{H}:fps={FPS},"
                f"trim=end_frame={n},setpts=PTS-STARTPTS,{cor},format=yuv420p[v{i}]"
            )
        else:
            vel = float(s.get("vel", 1))
            de = float(s["de"])
            usado = dur * vel
            entradas += ["-ss", f(de), "-t", f(usado + 0.3), "-i", str(pasta / s["arquivo"])]
            filtros.append(
                f"[{idx}:v]trim=start=0:duration={f(usado)},setpts=(PTS-STARTPTS)/{f(vel)},fps={FPS},"
                f"scale={W}:{H}:force_original_aspect_ratio=increase,crop={W}:{H},setsar=1,{cor},format=yuv420p[v{i}]"
            )
            if s.get("voz"):
                voz.append((idx, t, dur, vel))
        rotulos.append(f"[v{i}]")
        t += dur
    total = t
    filtros.append("".join(rotulos) + f"concat=n={len(rotulos)}:v=1:a=0[vout]")

    # --- áudio ---
    m = cfg["musica"]
    idx_m = entradas.count("-i")
    entradas += ["-ss", f(m.get("inicio", 0)), "-t", f(total + 0.5), "-i", str(pasta / m["arquivo"])]
    ent, sai, vol = m.get("entrada", 0.15), m.get("saida", 1.4), m.get("volume", 1.0)
    duck = m.get("abaixar_na_voz", 1.0)
    # ganho da música: desce suavemente (0,12 s) ao entrar a voz e sobe (0,3 s) ao sair
    g = "1"
    for _, ini, dur, _v in voz:
        a, b = ini, ini + dur
        rampa = f"min(1,max(0,min((t-{f(a-0.12)})/0.12,({f(b+0.3)}-t)/0.3)))"
        g += f"-(1-{f(duck)})*{rampa}"
    expr = f"{f(vol)}*({g})"
    filtros.append(
        f"[{idx_m}:a]atrim=0:{f(total)},asetpts=PTS-STARTPTS,afade=t=in:st=0:d={f(ent)},"
        f"afade=t=out:st={f(total - sai)}:d={f(sai)},volume='{expr}':eval=frame[mus]"
    )
    mix = ["[mus]"]
    for k, (idx, ini, dur, vel) in enumerate(voz):
        # voz de entrada usa o mesmo trecho; entrada já foi cortada com -ss de..de+dur*vel
        tempo = "" if abs(vel - 1) < 1e-6 else f"atempo={f(vel_atempo(vel))},"
        ms = int(round(ini * 1000))
        filtros.append(
            f"[{idx}:a]atrim=start=0:duration={f(dur * vel)},asetpts=PTS-STARTPTS,{tempo}"
            f"volume={f(cfg.get('voz_volume', 1.0))},adelay={ms}|{ms}[voz{k}]"
        )
        mix.append(f"[voz{k}]")
    filtros.append(
        "".join(mix) + f"amix=inputs={len(mix)}:duration=longest:normalize=0,alimiter=limit=0.95,atrim=0:{f(total)}[aout]"
    )
    return entradas, ";\n".join(filtros), total


def vel_atempo(vel):
    # atempo acelera por fator vel (vel<1 = câmera lenta no vídeo; a voz acompanha)
    return 1 / vel if vel else 1.0


def main():
    if len(sys.argv) < 2:
        sys.exit("uso: python scripts/montar.py <projeto>")
    nome = sys.argv[1]
    cfg = json.loads((RAIZ / "src" / "projetos" / nome / "montagem.json").read_text(encoding="utf-8"))
    pasta = RAIZ / "public" / "projetos" / nome
    saida = pasta / cfg.get("saida", "video.mp4")
    entradas, filtro, total = montar_filtro(cfg, pasta)
    script = pasta / "_montar_filtro.txt"
    script.write_text(filtro, encoding="utf-8")
    base = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", *entradas,
            "-/filter_complex", str(script), "-map", "[vout]", "-map", "[aout]"]
    fim = ["-r", str(cfg.get("fps", 30)), "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "192k",
           "-movflags", "+faststart", "-t", f(total), str(saida)]
    nvenc = base + ["-c:v", "h264_nvenc", "-cq", "19", "-preset", "p5"] + fim
    x264 = base + ["-c:v", "libx264", "-crf", "18", "-preset", "medium"] + fim
    print(f"montando {nome}: {len(cfg['segmentos'])} segmentos, duração prevista {total:.3f} s")
    if subprocess.run(nvenc).returncode != 0:
        print("nvenc falhou, usando libx264")
        if subprocess.run(x264).returncode != 0:
            sys.exit("ffmpeg falhou")
    script.unlink(missing_ok=True)
    dur = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(saida)],
                         capture_output=True, text=True).stdout.strip()
    print(f"saída: {saida}\nduração final (ffprobe): {float(dur):.3f} s (prevista {total:.3f} s)")


if __name__ == "__main__":
    main()
